# Скопируйте: cp .env.example .env  и заполните значения.
# .env НЕ коммитим в git!

# Окружение: development | production
ENVIRONMENT=development

# Секретный ключ JWT. Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Время жизни токена в минутах (1440 = 24 часа)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# База данных.
# В Docker (контейнер видит сервис db):
DATABASE_URL=postgresql://migrator_user:migrator_password_2026@db:5432/marketplace_migrator
# Если запускаете backend БЕЗ Docker (локально), раскомментируйте:
# DATABASE_URL=postgresql://migrator_user:migrator_password_2026@localhost:5432/marketplace_migrator

# CORS (JSON-список). По умолчанию: localhost:5173 и :3000
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]