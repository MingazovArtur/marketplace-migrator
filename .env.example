# ============================================================
# ВАЖНО: раньше здесь лежали РЕАЛЬНЫЕ секреты (JWT_SECRET, пароли,
# прод-IP). Они попали в git-историю → считаем скомпрометированными.
# Обязательно (в порядке приоритета):
#   1) Сгенерировать НОВЫЕ значения: python -c "import secrets; print(secrets.token_hex(32))"
#   2) Прогнать их на проде (docker compose -f docker-compose.prod.yml up -d --build)
#   3) Пароль админа сменить в ЛК приложения после первого входа
#   4) Git-историю с утечкой вычистить (git filter-repo / BFG) — Неделя 4 плана
# Никогда не помещайте настоящие значения в .env.example — только плейсхолдеры.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=migrator_user
POSTGRES_PASSWORD=CHANGE_ME__python_-c_import_secrets_print_secrets_token_hex_32
POSTGRES_DB=marketplace_migrator

# --- Приложение ---
# Подставьте пароль из POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://migrator_user:CHANGE_ME@db:5432/marketplace_migrator
REDIS_URL=redis://redis:6379/0
# Секрет подписи JWT: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME__python_-c_import_secrets_print_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Домен/фронт в проде; для локальной разработки — localhost
CORS_ORIGINS=https://your-domain.ru,http://localhost:5173

# --- Bootstrap админа (опционально) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=your@email.example
ADMIN_PASSWORD=CHANGE_ME__python_-c_import_secrets_print_secrets_token_hex_32

# --- Фронтенд (prod: относительный путь, проксирует nginx) ---
VITE_API_URL=/api

# --- Домен ---
APP_DOMAIN=your-domain.ru

# --- Окружение ---
# production — отключает Swagger (/docs, /redoc, /openapi.json)
ENVIRONMENT=development

# --- Куки аутентификации ---
# Secure-флаг кук: включить ТОЛЬКО после настройки HTTPS (setup-https.sh),
# иначе браузер не примет куку по http://IP
COOKIE_SECURE=false
