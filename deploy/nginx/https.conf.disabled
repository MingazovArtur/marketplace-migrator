# ============================================================
# ШАБЛОН HTTPS-конфига nginx (НЕ АКТИВЕН).
#
# Этот файл лежит ВНЕ conf.d/ — nginx его НЕ загружает. Если бы он
# попал в conf.d/ ДО выпуска сертификата, nginx упал бы при старте:
# файлов /etc/letsencrypt/live/__DOMAIN__/ ещё не существует.
#
# Активация — одной командой (купит домен, направит A-запись на сервер):
#   bash deploy/https/setup-https.sh vashdomen.ru admin@vashdomen.ru
# Скрипт выпустит сертификат, подставит домен вместо __DOMAIN__
# и положит результат в deploy/nginx/conf.d/https.conf.
# ============================================================

# --- Редирект HTTP → HTTPS только для домена ---
# Важно: ACME-челлендж остаётся на 80 порту — иначе продление
# сертификата каждые ~60 дней сломается. Bare-IP (***REMOVED***)
# продолжает открываться по HTTP — старые ссылки не умрут.
server {
    listen 80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Основной HTTPS-сервер ---
server {
    listen 443 ssl;
    # nginx:1.31 — поддерживается новый синтаксис.
    # Если когда-нибудь смените базовый образ на < 1.25 — замените
    # две строки выше на: listen 443 ssl http2;
    http2 on;

    server_name __DOMAIN__;

    # Сертификаты Let's Encrypt (named volume `certs`, read-only)
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    # Современный TLS (Mozilla intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/__DOMAIN__/chain.pem;
    resolver 8.8.8.8 1.1.1.1 valid=300s ipv6=off;

    # Security-заголовки
    # HSTS: браузер навсегда (год) помнит, что домен — только HTTPS.
    # Если планируете НЕ-https поддомены — уберите includeSubDomains.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API → backend (зона limit_req `api` объявлена в default.conf,
    # здесь только ссылка — повторное объявление = ошибка старта nginx)
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    # Медиа (копии фото)
    location /media/ {
        alias /var/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Статика фронта с долгим кэшем
    location ~* \.(js|css|png|jpg|jpeg|svg|woff2?)$ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
