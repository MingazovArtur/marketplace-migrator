# ==========================================
# Python / Backend
# ==========================================
# Виртуальные окружения
.venv/
venv/
env/
ENV/

# Скомпилированные файлы Python
__pycache__/
*.py[cod]
*$py.class

# Сборка и дистрибуция
build/
dist/
*.egg-info/
*.egg

# Секреты и переменные окружения
.env
.env.local
.env.*.local

# Сгенерированные данные и логи
photos/
*.log
export_log.txt

# ==========================================
# Node.js / Frontend
# ==========================================
# Зависимости (самое важное!)
node_modules/
frontend/node_modules/

# Результаты сборки (Production)
dist/
build/
frontend/dist/
frontend/build/

# Vite кэш
.vite/

# Логи пакетных менеджеров
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

